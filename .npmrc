# Exact versions only (architecture section 8, supply chain). `npm install <pkg>` writes no ^ or ~.
save-exact=true
# Never bypass the peer-dependency resolver (see TD-02: the next-auth override replaces --legacy-peer-deps).
legacy-peer-deps=false
# Install scripts run only for the packages listed in `allowScripts` in package.json (architecture
# section 8, supply chain). A new dependency that brings a script fails the install until a reviewer
# approves it with `npm approve-scripts`. Needs npm 11.17 or later (CI installs that version).
strict-allow-scripts=true
