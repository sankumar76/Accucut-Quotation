{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": [
    "atlassian",
    "github"
  ],
  "permissions": {
    "allow": [
      "mcp__atlassian",
      "mcp__github",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin docs/*)",
      "Bash(git rev-parse*)",
      "Bash(git merge origin/master)",
      "Bash(git remote -v*)",
      "Bash(ls*)",
      "Bash(tree*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * develop*)",
      "Bash(git push * release/*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git merge -*)",
      "Bash(git merge main*)",
      "Bash(git merge master*)",
      "Bash(git merge origin/main*)",
      "Bash(git merge origin/release*)",
      "Bash(git merge origin/feat*)",
      "Bash(git merge origin/fix*)",
      "Bash(git merge origin/docs*)",
      "Bash(git merge origin/control*)",
      "Bash(git merge origin/plant*)",
      "Bash(git merge origin/chore*)",
      "Bash(git merge origin/dependabot*)",
      "Bash(git merge feat*)",
      "Bash(git merge fix*)",
      "Bash(git merge docs*)",
      "Bash(git merge control*)",
      "Bash(git merge plant*)",
      "Bash(git merge chore*)",
      "Bash(git merge release*)",
      "Bash(git merge HEAD*)",
      "Bash(git merge FETCH_HEAD*)",
      "Bash(git merge origin/master *)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)",
      "Bash(curl * | *sh*)",
      "Bash(wget * | *sh*)",
      "mcp__github__delete_file",
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  }
}
