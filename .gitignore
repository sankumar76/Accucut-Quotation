# Append these lines to your repository's .gitignore
.claude/runs/
.claude/settings.local.json
.claude/agent-memory-local/
.env
.env.*
.superpowers/

# --- Application scaffold (STORY-10.01) ---
# TD-05: `.env.*` above would also hide the committed template, so re-include it. `.env` and every
# other `.env.*` stay ignored.
!.env.example

node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
coverage/
playwright-report/
test-results/
src/generated/
npm-debug.log*

# Keys, certificates and noise that `.env.*` does not cover (a public repository: defence in depth)
*.pem
*.key
*.p12
*.pfx
*.log
.DS_Store
