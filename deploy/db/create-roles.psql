-- The one source of the two database roles (STORY-10.01 AC-9 and STORY-10.04; architecture sections 5.1, 5.6, 9.9).
--
--   accucut_owner  runs migrations and owns the schema. Used by the migrate step only.
--   accucut_app    the runtime role used by the app and the worker. It can read and write rows but has
--                  no DDL rights: it cannot create, alter or drop anything.
--
-- Read by two callers, so the roles are the same everywhere:
--   - docker/postgres-init/01-create-roles.sh  (the local development database, and CI's PostgreSQL service)
--   - deploy/windows/install.ps1               (a Windows Server: PostgreSQL 17 from the vendor's installer)
--
-- Run it with psql (version 15 or later: \getenv), connected as a PostgreSQL superuser, with
-- ON_ERROR_STOP set. The passwords and the database name come from the environment and are read by psql
-- itself, so none of them is on a command line, where `ps` and /proc/*/cmdline (or Task Manager and
-- Get-CimInstance Win32_Process) would show it. Nothing is printed.
--   Needs: DB_OWNER_PASSWORD, DB_APP_PASSWORD, POSTGRES_DB.
--   Optional: DB_OWNER_CREATEDB=on gives the owner CREATEDB, which `prisma migrate dev` needs for its shadow
--   database. Development only. Absent, the owner has no CREATEDB, which is the production setting.
\getenv owner_password DB_OWNER_PASSWORD
\getenv app_password DB_APP_PASSWORD
\getenv dbname POSTGRES_DB
\set owner_createdb off
\getenv owner_createdb DB_OWNER_CREATEDB

CREATE ROLE accucut_owner LOGIN PASSWORD :'owner_password';
CREATE ROLE accucut_app LOGIN PASSWORD :'app_password';

\if :owner_createdb
ALTER ROLE accucut_owner CREATEDB;
\endif

ALTER DATABASE :"dbname" OWNER TO accucut_owner;
REVOKE ALL ON DATABASE :"dbname" FROM PUBLIC;
GRANT CONNECT ON DATABASE :"dbname" TO accucut_owner, accucut_app;

-- The schema belongs to the owner; the runtime role may use it but not create in it.
ALTER SCHEMA public OWNER TO accucut_owner;
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO accucut_app;

-- Whatever the owner creates later (migrations) is readable and writable by the runtime role.
-- Stories that need less (append-only audit, immutable calculations) revoke per table.
ALTER DEFAULT PRIVILEGES FOR ROLE accucut_owner IN SCHEMA public
  GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO accucut_app;
ALTER DEFAULT PRIVILEGES FOR ROLE accucut_owner IN SCHEMA public
  GRANT USAGE, SELECT ON SEQUENCES TO accucut_app;
