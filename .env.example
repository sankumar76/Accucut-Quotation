# Accucut Quotation Portal: environment template (architecture section 8 "Secrets", section 9.3).
#
# Copy this file to `.env` and replace every CHANGE_ME value. `.env` is git-ignored and must never be
# committed. This template holds variable names and placeholders only, never a real value.
# `src/lib/env.ts` validates these at start-up and refuses a value that still starts with CHANGE_ME.
# On a host, `.env` has mode 600.

# --- Database ---------------------------------------------------------------------------------
# Runtime role: no DDL rights. Used by `app` and `worker`.
DATABASE_URL=postgresql://accucut_app:CHANGE_ME_APP_PASSWORD@localhost:55432/accucut
# Owner role: runs migrations. Used by the `migrate` step only, never by `app` or `worker`.
MIGRATE_DATABASE_URL=postgresql://accucut_owner:CHANGE_ME_OWNER_PASSWORD@localhost:55432/accucut

# Local development database (compose.dev.yml only; not read by the application).
# Use letters and digits so the values can be copied into the two URLs above unchanged.
DB_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# --- Sessions and web address -------------------------------------------------------------------
# At least 32 random characters. Rotating it signs everyone out.
AUTH_SECRET=CHANGE_ME_AUTH_SECRET_AT_LEAST_32_CHARACTERS
# The portal's own origin, for the CSRF check and for links in e-mail. Not decided yet (Q-18).
APP_ORIGIN=http://localhost:3000

# --- Mail (architecture section 4.7) ------------------------------------------------------------
# SMTP_AUTH_MODE: none | password | oauth2-client-credentials
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH_MODE=none
# Mode `password` and `oauth2-client-credentials`: the mailbox user name.
SMTP_USER=
# Mode `password` only.
SMTP_PASSWORD=
# Mode `oauth2-client-credentials` only (Microsoft 365).
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=

# --- First Admin (read once by `bootstrap:admin`, then remove) ----------------------------------
ADMIN_EMAIL=admin@example.test
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
