# The session configuration of the Admin endpoint (STORY-10.11 AC-7; architecture section 9.9 "The Admin's account"; ADR-015 Amendment 3 forward note for 10.11).
#
# This file is a TEMPLATE. The install (install.ps1 -AdminAccount) fills in the tokens below and registers the result as the endpoint AccucutAdmin
# (Register-PSSessionConfiguration). The tokens are checked values, never anything typed into a script:
#   [ADMIN_ACCOUNT]          the Admin's Windows account (DOMAIN\user), the only one that may open the endpoint
#   [ADMIN_GROUP]            the local group that the virtual account joins (and is limited to; it is never a local administrator)
#   [TRANSCRIPT_DIRECTORY]   where the transcripts of every session go (C:\Accucut\logs\jea): the key is read as a secure string, so it is not in them
#   [ROLE_FILE]              the filled-in role capability file (AccucutAdmin.psrc)
@{
    SchemaVersion             = '2.0.0.0'
    GUID                      = '8c2a6e91-3f40-4d7b-b5a1-0e9d4c7f2a68'
    Author                    = 'Accucut'
    CompanyName               = 'Accucut'
    Description               = 'The Accucut Admin endpoint: two commands, run as a virtual account that is in one local group and nothing else.'
    SessionType               = 'RestrictedRemoteServer'
    RunAsVirtualAccount       = $true
    RunAsVirtualAccountGroups = @('{{ADMIN_GROUP}}')
    TranscriptDirectory       = '{{TRANSCRIPT_DIRECTORY}}'
    ExecutionPolicy           = 'Bypass'
    RoleDefinitions           = @{
        '{{ADMIN_ACCOUNT}}' = @{ RoleCapabilityFiles = '{{ROLE_FILE}}' }
    }
}
