// Tables arrive with the stories that own them (architecture section 5).
// Prisma 7: the connection URL is set in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The three roles of the portal (architecture section 6, FR-002). Stored as a PostgreSQL enum.
enum UserRole {
  ADMIN
  LEAD
  ENGINEER

  @@map("user_role")
}

/// A person who can sign in (STORY-01.01, architecture sections 5.1 and 8).
/// `email` is stored lower-case (a CHECK constraint holds it) so the unique index is case-insensitive.
/// A user is deactivated and never deleted, so the runtime role has no DELETE grant.
/// `session_version` ends every session of the user when it is raised (ADR-009).
/// The partial unique index `uq_users_single_active_admin` (one active Admin) is hand-written in the
/// migration: Prisma cannot express a partial index.
model User {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String
  passwordHash       String   @map("password_hash")
  role               UserRole
  isActive           Boolean  @default(true) @map("is_active")
  sessionVersion     Int      @default(0) @map("session_version")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  configVersions ConfigVersion[]
  auditEntries   AuditLog[]
  exchangeRates  ExchangeRate[]
  tasksToDo      Task[]          @relation("TaskEngineer")
  tasksAssigned  Task[]          @relation("TaskAssigner")
  calculations   Calculation[]

  @@unique([email], map: "uq_users_email")
  @@map("users")
}

/// Failed sign-in counters (architecture sections 5.1 and 6 "Rate limits", NFR-003, PROPOSED values).
/// `key_hash` is a keyed hash of an account key (the e-mail, known or not) or of an IP address, so the
/// table never holds an address or an e-mail in clear and an unknown e-mail looks like a known one.
/// `failures` is the number of attempts reserved in the current run or window (an attempt is counted before its password is
/// checked, and handed back by a correct password from a shared address). `window_started_at` is used by the per-IP rule
/// only; the account rule counts a run and ignores it. The natural key `key_hash` is the primary key (decision DL-072).
model LoginThrottle {
  keyHash         String    @id @map("key_hash")
  failures        Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at") @db.Timestamptz(6)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("login_throttles")
}

/// One immutable version of the field registry (ADR-004, architecture sections 4.5 and 5.1).
/// `snapshot` is the whole zod-validated configuration document. A row is never changed: a trigger
/// refuses UPDATE and DELETE for every role, and the runtime role holds no such grant (STORY-03.01).
/// `created_by` is null for version 1, the seed. Its foreign key to `users` was added with STORY-01.01
/// (architect ruling on AQP-97): no cascade, because users are deactivated and never deleted.
/// There is no `updated_at`: a row never changes after it is inserted.
model ConfigVersion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number    Int
  snapshot  Json
  createdBy String?  @map("created_by") @db.Uuid
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creator      User?         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_config_versions_created_by")
  calculations Calculation[]

  @@unique([number], map: "uq_config_versions_number")
  @@map("config_versions")
}

/// One record of who changed what and when (STORY-01.07, FR-011, NFR-007; architecture sections 5.1 and 8).
/// Append-only: a trigger refuses UPDATE, DELETE and TRUNCATE for every role, and the runtime role holds no such grant.
/// An entry is written in the same transaction as the change it records (the audit service takes the caller's transaction).
/// `object_label` is the name the object had at that moment, so a later rename does not rewrite history (AC-5); `actor_label`
/// is the same for the person who made the change, taken from the signed-in user of the request (architecture v0.27).
/// `before` and `after` are JSON and never hold a password, a hash or a token; `before` is null for a creation.
/// `created_at` is stamped by the database at the millisecond, so application code cannot back-date an entry and the
/// pagination cursor (time, id) survives a round trip through a JavaScript Date. There is no `updated_at`: a row never
/// changes after it is inserted (the append-only exception to coding standards section 10, "SQL").
/// The indexes carry the sort order of the screen, newest first; their names are those of architecture section 5.1.
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  actorLabel  String   @map("actor_label")
  event       String
  objectType  String   @map("object_type")
  objectId    String   @map("object_id") @db.Uuid
  objectLabel String   @map("object_label")
  before      Json?
  after       Json?
  requestId   String   @map("request_id")
  createdAt   DateTime @default(dbgenerated("date_trunc('milliseconds'::text, clock_timestamp())")) @map("created_at") @db.Timestamptz(6)

  actor User @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_audit_log_actor_id")

  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "idx_audit_log_created_at")
  @@index([actorId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_audit_log_actor_id")
  @@map("audit_log")
}

/// One named rate of the Process Master (STORY-02.01, FR-011, FR-012; architecture sections 5.1, 5.5 and 5.6).
/// A formula holds the rate's ID (`{{rate:<id>}}`), so renaming a rate never changes a formula. The 15 seed items of
/// SPEC section 4.1 are inserted by the migration with fixed IDs (prisma/seed/config/seed-ids.ts) and a default value of 0:
/// names and units are structure, the values are typed by the Admin at first use and never enter the repository (ADR-014).
/// The unique index on `lower(name)` (names differ by more than letter case, AC-2) and the CHECK constraints (a rate is
/// 0 or more, a name is not blank) are hand-written in the migration: Prisma cannot express them.
/// Class Restricted: the default value never reaches an Engineer.
model ProcessItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  unit         String
  defaultValue Decimal  @default(0) @map("default_value") @db.Decimal(18, 4)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customerRates CustomerRate[]

  @@unique([name], map: "uq_process_items_name")
  @@map("process_items")
}

/// One material of the Material Master (STORY-02.03, FR-015; architecture sections 4.9, 5.1 and 6; SPEC section 4.3).
/// `scrapRate` holds Material-Scrap-Rate, per kg (D-39). `isHidden` marks the "Not applicable" row that story 02.06 adds: the master
/// repository lists only rows where it is false, and `materialConsidered` is null only for that row. `deletedAt` is for the soft delete
/// of story 02.07 (A-13). The unique index on `lower(material_in_drawing)` (names differ by more than letter case, AC-2) and the CHECK
/// constraints (a price and a scrap rate are 0 or more, a specific gravity is above 0 unless the row is hidden, names are not blank) are
/// hand-written in the migration: Prisma cannot express them. Class Restricted: the three numbers never reach an Engineer.
model Material {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialInDrawing  String    @map("material_in_drawing")
  materialConsidered String?   @map("material_considered")
  pricePerKg         Decimal   @default(0) @map("price_per_kg") @db.Decimal(18, 4)
  specificGravity    Decimal   @default(0) @map("specific_gravity") @db.Decimal(18, 4)
  scrapRate          Decimal   @default(0) @map("scrap_rate") @db.Decimal(18, 4)
  isSystem           Boolean   @default(false) @map("is_system")
  isHidden           Boolean   @default(false) @map("is_hidden")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([materialInDrawing], map: "uq_materials_material_in_drawing")
  @@map("materials")
}

/// One exchange rate of the Exchange Rate Master (STORY-02.04, FR-016; architecture sections 5.1 and 6; SPEC sections 4.4 and 7.4): 1 unit of
/// `currency` in INR. The table holds at most two rows, USD and EUR, and is created EMPTY (ADR-014: no real rate is committed); the Admin types
/// the rates in. `updatedById` and `updatedAt` are the stamp of the last save that changed a rate, kept on both rows because the two rates are saved
/// together. `updatedAt` is set by the service from its clock (UTC), not by Prisma. The CHECK constraints (the currency is USD or EUR, a rate is 0 or
/// more) are hand-written in the migration: Prisma cannot express them. Class Restricted: a rate never reaches an Engineer.
/// Departs from the SQL conventions of the coding standards (section 10) on purpose, as architecture section 5.1 specifies: the table is keyed by
/// `currency` (two fixed rows) instead of an `id` UUID; the stamp columns are `updated_by` / `updated_at`; there is no `created_at`, because the table is
/// created empty and changed in place.
model ExchangeRate {
  currency    String   @id
  inrValue    Decimal  @map("inr_value") @db.Decimal(18, 4)
  updatedById String   @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  updatedBy User @relation(fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_exchange_rates_updated_by")

  @@map("exchange_rates")
}

/// One surface treatment or colour of the Treatment / Color list (STORY-02.05, FR-017; architecture sections 4.9, 5.1 and 6). `isSystem` marks the fixed
/// "Other" row that the migration inserts (locked: the service refuses to change or delete it) and, in story 02.06, "Not applicable". `isHidden` marks only
/// the second, so "Other" stays on the Admin's list; the master repository lists only rows where it is false. There is no `deletedAt`: a treatment is removed
/// with DELETE (the architecture gives `treatments` no soft delete). The unique index on `lower(name)` and the CHECK that a name is not blank are
/// hand-written in the migration: Prisma cannot express them. Class Internal: no rate of any kind.
/// `uq_treatments_name` (below) is implied by `uq_treatments_name_lower` and mirrors this `@@unique`, as `uq_materials_material_in_drawing` does: do not drop it as a duplicate. Hard `DELETE`, no `deleted_at`, as `process_items`.
model Treatment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([name], map: "uq_treatments_name")
  @@map("treatments")
}

/// One customer of the Customer Master (STORY-02.02, FR-013; architecture sections 5.1 and 6; SPEC section 4.2). Only the name is required (OQ-UX-04): the
/// phone, e-mail and address are optional text. `deletedAt` is for the soft delete of story 02.07 (A-13); the customer repository lists only rows where it is
/// null. The unique index on `lower(name)` (names differ by more than letter case, AC-1) and the CHECK that a name is not blank are hand-written in the
/// migration: Prisma cannot express them. `uq_customers_name` (below) is implied by `uq_customers_name_lower` and mirrors this `@@unique`: do not drop it as a
/// duplicate. Class Confidential: contact details are personal data and never reach an Engineer; `/options/customers` sends the ID and the name only.
model Customer {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  phone     String?
  email     String?
  address   String?
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates     CustomerRate[]
  estimates Estimate[]

  @@unique([name], map: "uq_customers_name")
  @@map("customers")
}

/// One customer's own value for one Process Master item (STORY-02.02, FR-012, FR-013; architecture section 5.1): normalised, one row per customer and item, so the
/// synchronisation of SPEC section 4.2 (a new item on every customer, a deleted item off every customer) is plain SQL. `value` is a rate in the item's unit
/// (a whole percentage for a percent item). The CHECK that a value is 0 or more is hand-written in the migration. Class Restricted: a value never reaches an Engineer.
model CustomerRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  processItemId String   @map("process_item_id") @db.Uuid
  value         Decimal  @db.Decimal(18, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_rates_customer_id")
  processItem ProcessItem @relation(fields: [processItemId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_customer_rates_process_item_id")

  @@unique([customerId, processItemId], map: "uq_customer_rates_customer_id_process_item_id")
  @@index([customerId], map: "idx_customer_rates_customer_id")
  @@index([processItemId], map: "idx_customer_rates_process_item_id")
  @@map("customer_rates")
}

/// The estimate status of architecture section 4.4. A new estimate is DRAFT; the other two arrive with EPIC-06.
enum EstimateStatus {
  DRAFT
  SUBMITTED
  APPROVED

  @@map("estimate_status")
}

/// The last number issued for each year, so a task code is `Q-<year>-<4 digits>` (STORY-04.01, FR-041; architecture section 5.1). The year is taken in IST.
/// The number is taken with one `INSERT ... ON CONFLICT DO UPDATE` inside the assigning transaction, which locks the year's row until that transaction ends,
/// so two requests at once get different numbers and a task that fails to save gives its number back. Departs from the SQL conventions (section 10) on purpose,
/// as architecture section 5.1 specifies: the table is keyed by `year` (one row per year) instead of an `id` UUID.
model TaskSequence {
  year      Int      @id
  lastValue Int      @map("last_value")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("task_sequences")
}

/// One piece of estimation work assigned to an Engineer by a Lead or Admin (STORY-04.01, FR-032, FR-033; architecture sections 4.1, 5.1 and 6). `code` is the
/// `Q-YYYY-NNNN` of the page addresses. `folderPath` is a UNC path kept as text (the portal never reads the share; the `file:` link is built from it on the
/// server). `deadlineAt` is the instant in UTC; the screens show it in IST. `assignmentRevision` is raised by a reassign (STORY-04.07) and is part of the key
/// of the "task assigned" e-mail (architecture section 4.7). The CHECKs (the path starts with two backslashes, the title and notes lengths, the revision is
/// at least 1) are hand-written in the migration: Prisma cannot express them. A task is never deleted, so the runtime role has no DELETE. Class Internal.
model Task {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String
  engineerId         String   @map("engineer_id") @db.Uuid
  assignedById       String   @map("assigned_by") @db.Uuid
  folderPath         String   @map("folder_path")
  deadlineAt         DateTime @map("deadline_at") @db.Timestamptz(6)
  title              String?
  notes              String?
  assignmentRevision Int      @default(1) @map("assignment_revision")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  engineer   User      @relation("TaskEngineer", fields: [engineerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_engineer_id")
  assignedBy User      @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_assigned_by")
  estimate   Estimate?

  @@unique([code], map: "uq_tasks_code")
  @@index([engineerId, deadlineAt], map: "idx_tasks_engineer_id_deadline_at")
  @@index([assignedById, deadlineAt], map: "idx_tasks_assigned_by_deadline_at")
  @@index([deadlineAt], map: "idx_tasks_deadline_at")
  @@map("tasks")
}

/// The estimate of a task (STORY-04.01; architecture sections 4.4, 4.8 and 5.1): one per task, created empty (DRAFT, customer not chosen) in the same transaction
/// as the task. `inputsRevision` is bumped by every input change (EPIC-05). `currentCalculationId` is the calculation the figures shown come from; its foreign key to `calculations` was added by STORY-03.05.
/// Class Confidential. The estimate is never deleted, so the runtime role has no DELETE.
model Estimate {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId               String         @map("task_id") @db.Uuid
  customerId           String?        @map("customer_id") @db.Uuid
  status               EstimateStatus @default(DRAFT)
  inputsRevision       Int            @default(0) @map("inputs_revision")
  currentCalculationId String?        @map("current_calculation_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  task               Task          @relation(fields: [taskId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estimates_task_id")
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estimates_customer_id")
  currentCalculation Calculation?  @relation("CurrentCalculation", fields: [currentCalculationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estimates_current_calculation_id")
  calculations       Calculation[] @relation("EstimateCalculations")
  nodes              EstimateNode[]

  @@unique([taskId], map: "uq_estimates_task_id")
  @@index([status], map: "idx_estimates_status")
  @@index([customerId], map: "idx_estimates_customer_id")
  @@map("estimates")
}

/// A part of an estimate's parts tree (STORY-05.02; architecture sections 4.8 and 5.1): one row per node, to any depth. `parentId` is null for a top-level item;
/// `sortIndex` is the place among the siblings, kept 0, 1, 2, ... by the service. **The Sl. No is derived from the tree and never stored.** `inputs` holds only
/// what a person typed, by field ID (empty until STORY-05.03); no rate, cost or formula is ever written here. `revision` is the node's own optimistic-lock count.
/// `imageId` has no foreign key until the pictures exist (STORY-05.07). Class Confidential. A part can be deleted, with its sub-parts, so the runtime role has
/// DELETE here; the foreign key to the parent has no cascade, so the service names every row it removes. Tree rules the schema cannot express (a parent in the
/// same estimate, no node as its own parent) are in the migration or the service.
model EstimateNode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  estimateId String   @map("estimate_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  sortIndex  Int      @map("sort_index")
  inputs     Json     @default("{}") @db.JsonB
  imageId    String?  @map("image_id") @db.Uuid
  revision   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  estimate Estimate       @relation(fields: [estimateId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estimate_nodes_estimate_id")
  parent   EstimateNode?  @relation("EstimateNodeChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estimate_nodes_parent_id")
  children EstimateNode[] @relation("EstimateNodeChildren")

  @@index([estimateId], map: "idx_estimate_nodes_estimate_id")
  @@index([parentId], map: "idx_estimate_nodes_parent_id")
  @@map("estimate_nodes")
}

/// One stored Calculate or Recalculate of an estimate (STORY-03.05, FR-031, NFR-026; ADR-007; architecture sections 4.2, 4.8 and 5.1): the configuration version it was
/// worked out with, the `inputs_revision` of the estimate at that moment, every master value it used (`master_snapshot`: the customer's rates, the materials and the two
/// exchange rates, with their names then, so a later change shows as a plain comparison, STORY-06.11), and the product figures (`product_values`: BL, BN and the total Tool
/// Cost as decimal text). `warnings` is `[]` until STORY-05.12. Every press writes a new row, so the history is kept; the estimate points at the latest through
/// `estimates.current_calculation_id`. Immutable: a trigger refuses UPDATE, DELETE and TRUNCATE for every role, and the runtime role holds only SELECT and INSERT, so a stored
/// figure cannot change when a master does. There is no `updated_at`: a row never changes after it is inserted (the immutable-table exception to coding standards section 10,
/// "SQL"; architecture section 5.1). The CHECK constraints (the JSON columns have the expected shape, the revision is not negative) are hand-written in the migration: Prisma
/// cannot express them. Class Restricted: every figure here is cost data and never reaches an Engineer (ADR-008, NFR-002).
model Calculation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  estimateId      String   @map("estimate_id") @db.Uuid
  configVersionId String   @map("config_version_id") @db.Uuid
  inputsRevision  Int      @map("inputs_revision")
  masterSnapshot  Json     @map("master_snapshot")
  productValues   Json     @map("product_values")
  warnings        Json     @default("[]")
  createdById     String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  estimate        Estimate         @relation("EstimateCalculations", fields: [estimateId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_calculations_estimate_id")
  configVersion   ConfigVersion    @relation(fields: [configVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_calculations_config_version_id")
  creator         User             @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_calculations_created_by")
  rows            CalculationRow[]
  linkedEstimates Estimate[]       @relation("CurrentCalculation")

  @@index([estimateId, createdAt(sort: Desc)], map: "idx_calculations_estimate_id")
  @@map("calculations")
}

/// One node of the tree as it was calculated (STORY-03.05; architecture section 5.1): a full copy, so the record needs nothing live. `sl_no` is the derived Sl. No as text,
/// `inputs` holds the typed values and the RESOLVED display text for Material in Drawing (E), Material Considered (F) and Treatment / Color (G), so renaming a material or a
/// treatment later cannot change a stored estimate (NFR-026), and `outputs` holds every calculated field as full-precision decimal text (`null` for no figure).
/// `node_id`, `parent_id` and `image_id` are plain UUIDs with NO foreign key on purpose: a node deleted or an image replaced later must not break a record, and the
/// tables they belong to (`estimate_nodes`, `part_images`) are created by later stories (assumption A-1 of the story). Immutable, like its calculation. Class Restricted.
model CalculationRow {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calculationId String   @map("calculation_id") @db.Uuid
  nodeId        String   @map("node_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  sortIndex     Int      @map("sort_index")
  slNo          String   @map("sl_no")
  inputs        Json
  imageId       String?  @map("image_id") @db.Uuid
  outputs       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  calculation Calculation @relation(fields: [calculationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_calculation_rows_calculation_id")

  @@unique([calculationId, nodeId], map: "uq_calculation_rows_calculation_id_node_id")
  @@index([calculationId, sortIndex], map: "idx_calculation_rows_calculation_id")
  @@map("calculation_rows")
}
